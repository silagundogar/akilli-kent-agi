# ==============================================================================
# AKILLI KENT AĞI (AKA) — ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# Bu dosyayı kopyalayarak .env adıyla kaydedin ve değerlerinizi girin.
# ==============================================================================

# Cloudflare API (DNS & SSL)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Oracle Cloud Infrastructure (OCI)
OCI_USER_OCID=ocid1.user.oc1..your_user_ocid
OCI_TENANCY_OCID=ocid1.tenancy.oc1..your_tenancy_ocid
OCI_FINGERPRINT=your_fingerprint_here
OCI_REGION=eu-frankfurt-1
OCI_KEY_FILE=path/to/your/oci_private_key.pem
OCI_INSTANCE_ID=ocid1.instance.oc1..your_instance_id
OCI_SERVER_IP=your_server_public_ip

# Supabase PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
